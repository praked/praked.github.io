// GENERATED by tools/make-backdrop.py from tools/backdrop.scss.tmpl.
// Edit those, not this file.
//
// Faint water/chart backdrop behind the page, echoing the cover's line art.
// Each layer is switched on by a bdx-* class on <html> (_layouts/base.html);
// the markup is _includes/backdrop.html. The reading column stays solid.

$bd-band: @@BAND@@;
$bd-waves: @@WAVES@@;
$bd-grid: @@GRID@@;
$bd-contours: @@CONTOURS@@;
$bd-pcb: @@PCB@@;
$bd-honey: @@HONEY@@;
$bd-rose: @@ROSE@@;

$bd-band-top: 22px;   // band tile offset from the top of the page

.bd, .bd-fixed, .bd-coords { display: none; }

html.bd-on {
  body { position: relative; }

  .bd, .bd-fixed {
    display: block;
    z-index: -1;
    pointer-events: none;
  }
  .bd { position: absolute; inset: 0; overflow: hidden; }
  .bd-fixed { position: fixed; inset: 0; }
  .bd > *, .bd-fixed > * { position: absolute; display: none; }

  // Line layers are masks over a block of text colour.
  .bd-mask { background: var(--body-color); }

  // The reading column: solid, with a soft edge, starting below the band.
  .content { position: relative; isolation: isolate; }
  .content::before {
    content: "";
    position: absolute;
    inset: 9rem -1.5rem 0;
    z-index: -1;
    background: var(--body-bg);
    box-shadow: 0 0 2.5rem 2rem var(--body-bg);
    pointer-events: none;
  }
}

@media print { .bd, .bd-fixed, .bd-coords { display: none !important; } }

// 1  Horizon band. The second mask layer is a solid block whose width the
// "draw" idea animates from 0 to 100%, so the band draws in left to right.
html.bdx-1 .bd-band {
  display: block;
  top: 0; left: 0; right: 0;
  height: $bd-band-top + 190px;
  -webkit-mask: $bd-band 0 #{$bd-band-top} / 800px 190px repeat-x, linear-gradient(#000, #000) 0 0 / 100% 100% no-repeat;
  -webkit-mask-composite: source-in;
  mask: $bd-band 0 #{$bd-band-top} / 800px 190px repeat-x, linear-gradient(#000, #000) 0 0 / 100% 100% no-repeat;
  mask-composite: intersect;
}

// 2  Margin waves (or the section motif)
html.bdx-2 .bd-waves {
  display: block;
  top: 220px; left: 0; right: 0; bottom: -60vh;
  -webkit-mask: $bd-waves 0 0 / 960px 840px repeat;
  mask: $bd-waves 0 0 / 960px 840px repeat;
}
html.bdx-motif[data-motif="pcb"] .bd-waves   { -webkit-mask: $bd-pcb 0 0 / 240px 240px repeat; mask: $bd-pcb 0 0 / 240px 240px repeat; }
html.bdx-motif[data-motif="honey"] .bd-waves { -webkit-mask: $bd-honey 0 0 / @@HONEY_SIZE@@ repeat; mask: $bd-honey 0 0 / @@HONEY_SIZE@@ repeat; }
html.bdx-motif[data-motif="rose"] .bd-waves  { -webkit-mask: $bd-rose 0 0 / 520px 520px repeat; mask: $bd-rose 0 0 / 520px 520px repeat; }

// 3  Chart grid + corner contours
html.bdx-3 {
  .bd-grid {
    display: block;
    inset: 0;
    -webkit-mask: $bd-grid 0 0 / 180px 180px repeat;
    mask: $bd-grid 0 0 / 180px 180px repeat;
  }
  .bd-contours {
    display: block;
    right: 0; bottom: 0; width: 560px; height: 470px;
    -webkit-mask: $bd-contours no-repeat;
    mask: $bd-contours no-repeat;
  }
}

// coords  Konstanz's position, set vertically in the right margin
html.bdx-coords .bd-coords {
  position: fixed;
  right: .9rem;
  bottom: 1.2rem;
  z-index: 1;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  font: 500 .68rem/1 ui-monospace, SFMono-Regular, Consolas, monospace;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--muted);
  opacity: .7;
  pointer-events: none;
}
@media screen and (min-width: 64em) { html.bdx-coords .bd-coords { display: block; } }

// draw  The band draws itself in once, left to right.
@keyframes bd-draw {
  from { -webkit-mask-size: 800px 190px, 0% 100%; mask-size: 800px 190px, 0% 100%; }
  to   { -webkit-mask-size: 800px 190px, 100% 100%; mask-size: 800px 190px, 100% 100%; }
}
@media (prefers-reduced-motion: no-preference) {
  html.bdx-draw .bd-band { animation: bd-draw 1.6s cubic-bezier(.3, .6, .2, 1) both; }
}

// parallax  Margin waves move at a fraction of the scroll speed (--sy is
// set by the script in _includes/backdrop.html).
@media (prefers-reduced-motion: no-preference) {
  html.bdx-parallax .bd-waves { transform: translate3d(0, calc(var(--sy, 0) * .45px), 0); }
}

// wind / arcs / depth are drawn by script into these SVGs.
html.bdx-wind .bd-wind,
html.bdx-arcs .bd-arcs,
html.bdx-depth .bd-depth { display: block; left: 0; top: 0; width: 100%; height: 100%; }
.bd-wind path, .bd-arcs path, .bd-depth path { fill: none; stroke: var(--body-color); vector-effect: non-scaling-stroke; }
.bd-arcs circle { fill: var(--body-color); }
.bd-depth text { fill: var(--muted); font: .62rem ui-monospace, Consolas, monospace; letter-spacing: .08em; }
